{
  "manifest_version": 3,
  "name": "Video Downloader MVP",
  "version": "1.0.0",
  "description": "Extension de téléchargement de contenus autorisés",
  "permissions": [
    "downloads",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}