guageName":{"simpleText":"Tswana"}},{"languageCode":"tum","languageName":{"simpleText":"Tumbuka"}},{"languageCode":"tr","languageName":{"simpleText":"Turkish"}},{"languageCode":"tk","languageName":{"simpleText":"Turkmen"}},{"languageCode":"uk","languageName":{"simpleText":"Ukrainian"}},{"languageCode":"ur","languageName":{"simpleText":"Urdu"}},{"languageCode":"ug","languageName":{"simpleText":"Uyghur"}},{"languageCode":"uz","languageName":{"simpleText":"Uzbek"}},{"languageCode":"ve","languageName":{"simpleText":"Venda"}},{"languageCode":"vi","languageName":{"simpleText":"Vietnamese"}},{"languageCode":"war","languageName":{"simpleText":"Waray"}},{"languageCode":"cy","languageName":{"simpleText":"Welsh"}},{"languageCode":"fy","languageName":{"simpleText":"Western Frisian"}},{"languageCode":"wo","languageName":{"simpleText":"Wolof"}},{"languageCode":"xh","languageName":{"simpleText":"Xhosa"}},{"languageCode":"yi","languageName":{"simpleText":"Yiddish"}},{"languageCode":"yo","languageName":{"simpleText":"Yoruba"}},{"languageCode":"zu","languageName":{"simpleText":"Zulu"}}],"defaultAudioTrackIndex":0}},"videoDetails":{"videoId":"oofSnsGkops","title":"James Blunt - You're Beautiful (Official Music Video) [4K]","lengthSeconds":"202","keywords":["James Blunt","You're Beautiful","James Blunt You're Beautiful","You're Beautiful Official Video","You're Beautiful Lyrics","James Blunt 2004","Back To Bedlam","James Blunt Back To Bedlam","James Blunt Songs","James Blunt Music","James Blunt Official Video","James Blunt Lyrics","Pop","Rock","Soft Rock","Singer-Songwriter","Male UK Pop","English Songs","James Blount","JamesBlunt","Your Beautiful","James Blunt Your Beautiful","You Are Beautiful","beautiful","biutiful","you're beautiful its true"],"channelId":"UCUg8KhMXhFxJm-YQzOQ7nPw","isOwnerViewing":false,"shortDescription":"The official music video for James Blunt - You're Beautiful remastered in 4K\n\nTaken from the debut album 'Back To Bedlam' released in 2004, which featured the singles, 'High', 'Wisemen', 'You're Beautiful', 'Goodbye My Lover' and 'No Bravery'.\n\nSubscribe to the James Blunt channel for the latest official music videos, behind the scenes and live performances here -  https://atlantic.lnk.to/JamesBluntSubscribe\n\nListen to more from the album 'Back To Bedlam' here: https://www.youtube.com/playlist?list=OLAK5uy_lsRQUwZEe2CE78HUlhoJd-Uth_t7aGDyw\n\nSee more official videos from James Blunt here: https://www.youtube.com/playlist?list=PL2C6E87117167B7C6\n\nFollow James Blunt:\nhttp://jamesblunt.com\nTwitter: http://twitter.com/jamesblunt\nFacebook: http://facebook.com/jamesblunt\nInstagram: http://instagram.com/jamesblunt\nTik Tok: https://tiktok.com/@jamesblunt/\n\nAbout James Blunt:\nJames Blunt is an internationally acclaimed multi-million selling artist known for his powerful performances, distinctive voice and a knack for crafting melodic, contemporary pop songs. \n \nHis catalogue includes 2004's 'Back to Bedlam', which became the one of the best selling albums of the Noughties, as well as albums All The Lost Souls, Some Kind Of Trouble, Moon Landing, The Afterlove and Once Upon A Mind, which have spawned hits such as 'You're Beautiful', 'Goodbye My Lover', 'Wisemen', '1973', 'Stay The Night', 'Bonfire Heart', and ‘Monsters\n\n#JamesBlunt #YoureBeautiful #BackToBedlam","isCrawlable":true,"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/oofSnsGkops/hqdefault.jpg?sqp=-oaymwEiCKgBEF5IWvKriqkDFQgBFQAAAAAYASUAAMhCPQCAokN4AQ==\u0026rs=AOn4CLARM7J8pcBDDMwJKW-sUSCbLryNxg","width":168,"height":94},{"url":"https://i.ytimg.com/vi/oofSnsGkops/hqdefault.jpg?sqp=-oaymwEiCMQBEG5IWvKriqkDFQgBFQAAAAAYASUAAMhCPQCAokN4AQ==\u0026rs=AOn4CLAenOpIi4Sa_4b8CGO35OOS1qsUaA","width":196,"height":110},{"url":"https://i.ytimg.com/vi/oofSnsGkops/hqdefault.jpg?sqp=-oaymwEjCPYBEIoBSFryq4qpAxUIARUAAAAAGAElAADIQj0AgKJDeAE=\u0026rs=AOn4CLCzEoEMrFQGkCWZYnQtqlGHs88BfQ","width":246,"height":138},{"url":"https://i.ytimg.com/vi/oofSnsGkops/hqdefault.