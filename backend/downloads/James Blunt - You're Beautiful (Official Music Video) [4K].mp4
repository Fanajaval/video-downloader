round":4294964976,"raisedBackground":4294964976,"additiveBackground":566853445,"textPrimary":4281736458,"textSecondary":4285419578,"invertedBackground":4287580953,"overlayBackground":3426098442},"darkThemeColorPalette":{"baseBackground":4280028418,"raisedBackground":4281736458,"additiveBackground":734625605,"textPrimary":4294634464,"textSecondary":4292723116,"invertedBackground":4293110140,"overlayBackground":3426098442},"enableColorSampledText":true}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"2009"},"label":{"simpleText":"Oct 26"},"accessibilityText":"Oct 26, 2009","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294964976,"raisedBackground":4294964976,"additiveBackground":566853445,"textPrimary":4281736458,"textSecondary":4285419578,"invertedBackground":4287580953,"overlayBackground":3426098442},"darkThemeColorPalette":{"baseBackground":4280028418,"raisedBackground":4281736458,"additiveBackground":734625605,"textPrimary":4294634464,"textSecondary":4292723116,"invertedBackground":4293110140,"overlayBackground":3426098442},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBgQ040EGAYiEwi528O89sKWAxWUCFUIHWAEJzLKAQRMIQTw","commandMetadata":{"webCommandMetadata":{"url":"/@JamesBlunt","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCUg8KhMXhFxJm-YQzOQ7nPw","canonicalBaseUrl":"/@JamesBlunt"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/VBBbluHIHx6v7bs6PB71DWwF7vKx4BgmzXPsoniwuFS-FkAq1Lv3Uwl6ALK1gRaEo71elLto=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Show more"}},"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"attributedDescriptionBodyText":{"content":"The official music video for James Blunt - You're Beautiful remastered in 4K\n\nTaken from the debut album 'Back To Bedlam' released in 2004, which featured the singles, 'High', 'Wisemen', 'You're Beautiful', 'Goodbye My Lover' and 'No Bravery'.\n\nSubscribe to the James Blunt channel for the latest official music videos, behind the scenes and live performances here -  https://atlantic.lnk.to/JamesBluntSub...\n\nListen to more from the album 'Back To Bedlam' here:    • Back to Bedlam  \n\nSee more official videos from James Blunt here:    • James Blunt - Official Videos Playlist  \n\nFollow James Blunt:\nhttp://jamesblunt.com\nTwitter:   / jamesblunt  \nFacebook:   / jamesblunt  \nInstagram:   / jamesblunt  \nTik Tok:   / jamesblunt  \n\nAbout James Blunt:\nJames Blunt is an internationally acclaimed multi-million selling artist known for his powerful performances, distinctive voice and a knack for crafting melodic, contemporary pop songs. \n \nHis catalogue includes 2004's 'Back to Bedlam', which became the one of the best selling albums of the Noughties, as well as albums All The Lost Souls, Some Kind Of Trouble, Moon Landing, The Afterlove and Once Upon A Mind, which have spawned hits such as 'You're Beautiful', 'Goodbye My Lover', 'Wisemen', '1973', 'Stay The Night', 'Bonfire Heart', and ‘Monsters\n\n#JamesBlunt #YoureBeautiful #BackToBedlam","commandRuns":[{"startIndex":368,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBgQ040EGAYiEwi528O89sKWAxWUCFUIHWAEJzJIm8WSjezT9MOiAcoBBEwhBPA=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rU2trUDBpY3RDVU94S04tQ2VWZzNGX3xBR3JiS2FuUjZxTEo0bHBDSWRGM3RpdTIyejlta0lYeVVkOW5FaV8xZk5KSGVHVGEtUXhIR2VVU1hoV0NGZUJxWFU4S1F4cEl3SFc3MERxMzdpMkZXbmpOd0lGVml1NU5QYXRq\u0026q=https%3A%2F%2Fatlantic.lnk.to%2FJamesBluntSubscribe\u0026v=oofSnsGkops","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\