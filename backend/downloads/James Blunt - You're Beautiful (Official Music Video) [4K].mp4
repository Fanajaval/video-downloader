_UNSPECIFIED"},{"startIndex":601,"length":21,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":622,"length":10,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":632,"length":16,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":648,"length":11,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":659,"length":16,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":675,"length":12,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":687,"length":16,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":703,"length":10,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":713,"length":16,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":729,"length":575,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1304,"length":11,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1315,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1316,"length":15,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1331,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1332,"length":13,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294964976,"raisedBackground":4294964976,"additiveBackground":566853445,"textPrimary":4281736458,"textSecondary":4285419578,"invertedBackground":4287580953,"overlayBackground":3426098442},"darkThemeColorPalette":{"baseBackground":4280028418,"raisedBackground":4281736458,"additiveBackground":734625605,"textPrimary":4294634464,"textSecondary":4292723116,"invertedBackground":4293110140,"overlayBackground":3426098442},"colorSampledDescriptionBodyText":{"content":"The official music video for James Blunt - You're Beautiful remastered in 4K\n\nTaken from the debut album 'Back To Bedlam' released in 2004, which featured the singles, 'High', 'Wisemen', 'You're Beautiful', 'Goodbye My Lover' and 'No Bravery'.\n\nSubscribe to the James Blunt channel for the latest official music videos, behind the scenes and live performances here -  https://atlantic.lnk.to/JamesBluntSub...\n\nListen to more from the album 'Back To Bedlam' here:    • Back to Bedlam  \n\nSee more official videos from James Blunt here:    • James Blunt - Official Videos Playlist  \n\nFollow James Blunt:\nhttp://jamesblunt.com\nTwitter:   / jamesblunt  \nFacebook:   / jamesblunt  \nInstagram:   / jamesblunt  \nTik Tok:   / jamesblunt  \n\nAbout James Blunt:\nJames Blunt is an internationally acclaimed multi-million selling artist known for his powerful performances, distinctive voice and a knack for crafting melodic, contemporary pop songs. \n \nHis catalogue includes 2004's 'Back to Bedlam', which became the one of the best selling albums of the Noughties, as well as albums All The Lost Souls, Some Kind Of Trouble, Moon Landing, The Afterlove and Once Upon A Mind, which have spawned hits such as 'You're Beautiful', 'Goodbye My Lover', 'Wisemen', '1973', 'Stay The Night', 'Bonfire Heart', and ‘Monsters\n\n#JamesBlunt #YoureBeautiful #BackToBedlam","commandRuns":[{"startIndex":368,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBgQ040EGAYiEwi528O89sKWAxWUCFUIHWAEJzJIm8WSjezT9MOiAcoBBEwhBPA=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rU3JZMGZ4LTJ1S0hZRFZ6S3Nsby1yOXxBR3JiS2FsTWpYZUNFVHZnYUphaW5xdmxqMjhXbFhjQ3M2YzVRQnN1R0Q3UUdWbkJ6eE1FTnc4STFKd0N3RGY1WlVXMnVLT0RMbkZtbXdBRy0yS0h6Z3dVdzJKTW5RRGxHWnQ3\u0026q=https%3A%2F%2Fatlantic.lnk.to%2FJamesBluntSubscribe\u0026v=oofSnsGkops","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtub